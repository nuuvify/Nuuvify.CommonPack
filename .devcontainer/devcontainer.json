{
    "name": "(.NET)",
    "build": {
        "context": ".",
        "dockerfile": "Dockerfile",
        "args": { 
            "PathApp": "${containerWorkspaceFolder}",
            "NugetMode": "SKIP",
            "UserApp": "devcontainer",
            "HttpProxyEnv": "${localEnv:HTTP_PROXY}",
            "HttpsProxyEnv": "${localEnv:HTTPS_PROXY}",
            "NoProxyEnv": "${localEnv:NO_PROXY}"
        }
    },
    "containerUser": "devcontainer",
    "features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"configureZshAsDefaultShell": true,
			"installOhMyZsh": true,
			"installOhMyZshConfig": true,
			"upgradePackages": true
		},
		"ghcr.io/devcontainers-contrib/features/zsh-plugins:0": {
			"plugins": "git git-flow F-Sy-H zsh-autosuggestions zsh-completions",
			"omzPlugins": "https://github.com/z-shell/F-Sy-H https://github.com/zsh-users/zsh-autosuggestions https://github.com/zsh-users/zsh-completions"
        },
		"ghcr.io/stuartleeks/dev-container-features/shell-history:0": {}
    },

    "mounts": [
        "source=/${localEnv:HOME}/.nuget/NuGet/NuGet.Config,target=/home/devcontainer/.nuget/NuGet/NuGet.Config,type=bind,consistency=cached",
        "source=/${localEnv:HOME}/.ssh,target=/home/devcontainer/.ssh,type=bind,consistency=cached",
        "source=/${localEnv:HOME}/.microsoft/usersecrets,target=/home/devcontainer/.microsoft/usersecrets,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/.devcontainer/atomic.omp.json,target=/home/devcontainer/.config/atomic.omp.json,type=bind,consistency=cached"
    ],
    "postStartCommand": "/bin/bash /home/devcontainer/change-owner.sh",

    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.fontFamily": "MesloLGM NF",
                "terminal.integrated.defaultProfile.linux": "zsh"
            },
            "extensions": [
                "ms-dotnettools.csharp",
                "k--kato.docomment",
                "ms-dotnettools.csdevkit",
                "eamodio.gitlens",
                "ecmel.vscode-html-css",
                "bianxianyang.htmlplay",
                "VisualStudioExptTeam.vscodeintellicode",
                "ms-dotnettools.vscodeintellicode-csharp",
                "ms-vsliveshare.vsliveshare",
                "yzhang.markdown-all-in-one",
                "patcx.vscode-nuget-gallery",
                "quicktype.quicktype",
                "christian-kohler.path-intellisense",
                "humao.rest-client",
                "Shynet.vscode-taskkill",
                "Gruntfuggly.todo-tree",
                "ms-vscode-remote.vscode-remote-extensionpack"
            ]
        }
    }
}
